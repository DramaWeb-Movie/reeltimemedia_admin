# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=

# Upload limits (optional; defaults in code)
MAX_FILE_SIZE=52428800
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/quicktime
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
USER_WEB_URL=

# Social notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Transcode service (called from Next.js server routes)
TRANSCODE_SERVICE_URL=http://localhost:8080
TRANSCODE_SERVICE_SECRET=

# Admin: PIN required before login page
ADMIN_PIN=

# One-time admin seed (only for: npm run create-admin)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
